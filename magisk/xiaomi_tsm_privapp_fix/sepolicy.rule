allow priv_app secure_element_service service_manager find
allow priv_app property_socket sock_file write
allow priv_app init unix_stream_socket connectto
allow priv_app nfc_prop property_service set

# OEM MTD: dedicated domain for the unchanged, hash-verified executable.
# The ROM omits the OEM hwservice context; default registry access is restricted
# to this trusted daemon and its secure-element HAL client, never application domains.
type hal_mtdservice_default domain
typeattribute hal_mtdservice_default halserverdomain
type hal_mtdservice_default_exec file_type
typeattribute hal_mtdservice_default_exec exec_type
typeattribute hal_mtdservice_default_exec vendor_file_type
allow init hal_mtdservice_default_exec file { read getattr map execute open }
allow init hal_mtdservice_default process { transition siginh rlimitinh }
type_transition init hal_mtdservice_default_exec process hal_mtdservice_default
allow hal_mtdservice_default hal_mtdservice_default_exec file { read getattr map execute open entrypoint }
allow hal_mtdservice_default hwservicemanager binder { call transfer }
allow hwservicemanager hal_mtdservice_default binder { call transfer }
